{
  "name": "tevorli",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/export-security.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:security": "node scripts/security-check.mjs",
    "test:performance": "node scripts/performance.mjs",
    "build:vercel": "npm run build && node scripts/vercel-output.mjs",
    "test:secrets": "node scripts/secret-scan.mjs",
    "test:deployment": "node scripts/check-deployment.mjs",
    "build:preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "lighthouse": "13.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "type": "module"
}
